{
  "manifest_version": 3,
  "name": "u2b YouTube & Video Downloader",
  "version": "1.0.8",
  "description": "右键一键调用本地 u2b 下载 YouTube、B站、抖音、小红书、TikTok、X 视频或 MP3，支持页内实时进度卡片与 Finder 定位。",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage",
    "notifications",
    "activeTab",
    "tabs",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://*.bilibili.com/*",
    "*://*.douyin.com/*",
    "*://*.kuaishou.com/*",
    "*://*.xiaohongshu.com/*",
    "*://*.weibo.com/*",
    "*://*.ixigua.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.tiktok.com/*",
    "*://*.instagram.com/*",
    "*://*.twitch.tv/*",
    "*://*.vimeo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "u2b 下载器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.bilibili.com/*",
        "*://*.douyin.com/*",
        "*://*.kuaishou.com/*",
        "*://*.xiaohongshu.com/*",
        "*://*.weibo.com/*",
        "*://*.ixigua.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*",
        "*://*.twitch.tv/*",
        "*://*.vimeo.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
